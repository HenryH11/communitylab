# ==============================================================================
# Variables de Entorno - CommunityLab
# ==============================================================================

# Claves de API de Proveedores de LLM
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Configuración de Proveedores (nvidia_nim | gemini)
COMMUNITYLAB_PROVEEDOR_ANALISIS=nvidia_nim
COMMUNITYLAB_PROVEEDOR_GENERACION=nvidia_nim

# Modelo NVIDIA NIM configurado por defecto para el tier estándar
COMMUNITYLAB_MODELO_NVIDIA=nvidia/nemotron-3.5-lightning-30b-a3b
COMMUNITYLAB_NVIDIA_TIMEOUT_SEGUNDOS=15.0

# Enrutamiento Adaptativo de Modelos por Tier (rápido, estándar, razonamiento)
COMMUNITYLAB_ENRUTAMIENTO_ADAPTATIVO=true
COMMUNITYLAB_MODELO_NVIDIA_RAPIDO=nvidia/nemotron-3.5-lightning-30b-a3b
COMMUNITYLAB_MODELO_NVIDIA_ESTANDAR=nvidia/nemotron-3.5-lightning-30b-a3b
COMMUNITYLAB_MODELO_NVIDIA_RAZONAMIENTO=nvidia/nemotron-3-super-120b-a12b

# Observabilidad y Logs
COMMUNITYLAB_LOGS=1
COMMUNITYLAB_LOG_LEVEL=INFO

# Persistencia Cloud OCI (Oracle Cloud Infrastructure) - Opcional
OCI_CONFIG_DIR=~/.oci
OCI_PROFILE=DEFAULT
OCI_BUCKET_NAME=communitylab-activos-marketing

# Autonomous DB: carga interna (configurar fuera de Git, sin contraseñas aquí).
DB_USER=agent_communitylab
DB_DSN=
DB_PASSWORD_SECRET_OCID=

# Agente: usuario y secreto distintos, con SELECT únicamente sobre ambas tablas.
# DB_READ_DSN vacío reutiliza DB_DSN, nunca las credenciales del cargador.
DB_READ_USER=agent_consulta
DB_READ_DSN=
DB_READ_PASSWORD_SECRET_OCID=
