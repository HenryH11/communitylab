      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "cml-00217",
      "type": "text",
      "x": 3532,
      "y": 625,
      "width": 359,
      "height": 120.96000000000001,
      "angle": 0,
      "strokeColor": "#161C32",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
