      "text": "¿Qué nos está diciendo la comunidad?",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 17,
      "containerId": null,
      "originalText": "¿Qué nos está diciendo la comunidad?",
