      "versionNonce": 2025481028,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791922160712,
      "link": null,
      "locked": false,
      "text": "Escuchar las conversaciones permite encontrar\nideas que conectan mejor con las personas.\n\nEsta semana encontramos preguntas recurrentes,\ninterés por soluciones prácticas y oportunidades\npara explicar mejor nuestros servicios.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
