# ==============================================================================
# Variables de Entorno - CommunityLab
# ==============================================================================
# Plantilla de referencia, no configuracion operativa ni copia del entorno cloud.
# No subir .env, .env.interno, contrasenas, llaves ni valores reales de secretos.
# Dos VM: crear un .env propio en cada una, solo con las variables de su rol.
# Marketing: claves IA, modelos, DB_READ_* y OCI_BUCKET_NAME; nunca DB_USER,
# DB_DSN ni DB_PASSWORD_SECRET_OCID. No necesita INGESTOR_URL ni salida TCP 8000.
# Ingestor: DB_USER, DB_DSN, DB_PASSWORD_SECRET_OCID e INGESTOR_BIND_IP.
# El backend no necesita claves de IA ni credenciales del lector.

# Claves de API de Proveedores de LLM
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Configuración de Proveedores (nvidia_nim | gemini)
COMMUNITYLAB_PROVEEDOR_ANALISIS=nvidia_nim
COMMUNITYLAB_PROVEEDOR_GENERACION=nvidia_nim

# Modelo Gemini configurable
COMMUNITYLAB_MODELO_GEMINI=gemini-3.5-flash-lite

# Modelo NVIDIA global (utilizado sin enrutamiento adaptativo)
COMMUNITYLAB_MODELO_NVIDIA=nvidia/nemotron-3.5-super-vl-120b-a12b
COMMUNITYLAB_NVIDIA_TIMEOUT_SEGUNDOS=15.0

# Enrutamiento Adaptativo de Modelos por Tier (rápido, estándar, razonamiento)
COMMUNITYLAB_ENRUTAMIENTO_ADAPTATIVO=true
COMMUNITYLAB_MODELO_NVIDIA_RAPIDO=nvidia/nemotron-3.5-lightning-30b-a3b
COMMUNITYLAB_MODELO_NVIDIA_ESTANDAR=nvidia/nemotron-3.5-super-vl-120b-a12b
COMMUNITYLAB_MODELO_NVIDIA_RAZONAMIENTO=nvidia/nemotron-3.5-super-vl-120b-a12b
# Interpretacion del agente: independiente del modelo utilizado para redactar.
COMMUNITYLAB_MODELO_NVIDIA_INTERPRETACION=nvidia/nemotron-3.5-super-vl-120b-a12b

# Solo servidor: presupuesto operativo comun para el agente y su respaldo.
# No representa el maximo anunciado por el proveedor. Sin controles en el front.
# La entrada se estima conservadoramente por bytes UTF-8, con margen adicional.
COMMUNITYLAB_CONTEXTO_TOKENS=32768
COMMUNITYLAB_SALIDA_TOKENS=4096
# Solo servidor: intentos reales (incluye reintentos y respaldo), por consulta.
COMMUNITYLAB_MAX_INTENTOS_CONSULTA=30
COMMUNITYLAB_MAX_TOKENS_CONSULTA=250000
COMMUNITYLAB_MAX_CONSULTAS_ACTIVAS=2
# 0 desactiva cuota horaria; NO hay techo acumulado de gasto con este valor.
COMMUNITYLAB_MAX_INTENTOS_HORA=0

# Concurrencia de Data Science
# Valores permitidos: 1 o 2
# 1 = secuencial (predeterminado)
# 2 = concurrente (experimental)

COMMUNITYLAB_CONCURRENCIA_LOTES_ANALISIS=2
COMMUNITYLAB_CONCURRENCIA_MENSAJES=2

# Observabilidad y Logs
COMMUNITYLAB_LOGS=1
COMMUNITYLAB_LOG_LEVEL=INFO

# Persistencia Cloud OCI (Oracle Cloud Infrastructure)
# Opcional para uso local sin cloud; necesaria para leer Oracle/catalogo reales.
# VM: instance_principal. Desarrollo local: api_key con perfil IAM de solo lectura.
OCI_AUTH_MODE=instance_principal
# Opcional: ruta completa al archivo config; prevalece sobre OCI_CONFIG_DIR.
OCI_CONFIG_FILE=
OCI_CONFIG_DIR=~/.oci
OCI_PROFILE=DEFAULT
OCI_BUCKET_NAME=bkt-communitylab-marketing
# Catalogo diario: mismo bucket, objeto plantillas/catalogo_actual.json.
# Ejecutor externo: python -m scripts.generar_plantillas_diarias
# Horario fijo del producto: 08:00 America/Bogota (13:00 UTC).

# Marketing arranca con src/app/app.py; no acepta COMMUNITYLAB_MODO_INTERNO.
# El equipo tecnico usa src/app/app_interna.py en otro proceso restringido.
# Para Compose, configurar las variables internas solo en .env.interno.
# Autonomous DB: escritor, solo en el entorno del ingestor.
# Nombres alineados con Compose; Cloud debe confirmar los usuarios provisionados.
DB_USER=rw_ingest_communitylab
# Copiar el DSN completo de la conexion TLS autorizada, incluido servicio y puerto.
# No inferirlo de una IP, no poner usuario/contrasena en el DSN.
# La lectura observada usaba TCPS 1521; confirmar el DSN escritor por separado.
DB_DSN=
# OCID del secreto de la contrasena escritora, no la contrasena ni un OCID de clave.
# La identidad del backend debe poder leerlo; no concederlo a Marketing.
DB_PASSWORD_SECRET_OCID=

# Agente: usuario y secreto distintos, con SELECT únicamente sobre ambas tablas.
# En Marketing definir DB_READ_DSN explicitamente: Compose no entrega DB_DSN.
DB_READ_USER=ro_query_communitylab
DB_READ_DSN=
# OCID del secreto lector; no reutilizar el escritor.
DB_READ_PASSWORD_SECRET_OCID=

# Solo para docker-compose.backend.yml en la VM de ingesta.
# IP privada asignada a esa VM; no usar 0.0.0.0 ni una IP publica.
INGESTOR_BIND_IP=

# Solo backend: etiqueta reconocible y entorno de la base REAL configurada.
# No basta con llamarla demostracion: Cloud debe aislar su esquema/base de datos.
INGESTOR_DESTINO=
INGESTOR_ENTORNO=
# INGESTOR_ENTORNO admite demostracion o produccion.
# Solo .env.interno: URL base privada, sin /sincronizar (NO incluir en Marketing).
# INGESTOR_URL=http://communitylab-ingestor:8000

# ACL de Oracle, rutas Service Gateway, NSG y permisos de Vault/Object Storage
# se configuran en OCI: no quedan aplicados por rellenar este archivo.
# Conservar Marketing separado del ejecutor interno autorizado para la ingesta.
# Las tablas temporales CE_* son de validacion: no son variables de despliegue.
